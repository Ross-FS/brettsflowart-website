{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brettsflowart-website",
  "main": "./worker/index.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
