---
import MainLayout from '../layouts/MainLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Hero from '../components/Hero.astro';
import ContactCard from '../components/ContactCard.astro';
import Biography from '../components/Biography.astro';
import EtsyListings from '../components/EtsyListings.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<MainLayout>
  <SiteHeader />
  <main id="main-content">
    <Hero />
    <ContactCard />

    <section class="section shell etsy-preview-section" aria-labelledby="etsy-preview-title">
      <div class="section-heading">
        <p class="eyebrow">Available now</p>
        <h2 id="etsy-preview-title">Explore Brett's available work</h2>
        <p>Current artwork, prices and availability are supplied directly from Brett's Etsy store.</p>
      </div>
      <EtsyListings preview />
    </section>

    <Biography />
  </main>
  <SiteFooter />
</MainLayout>

<style is:global>
  #main-content .section-heading {
    width: 100%;
    max-width: none;
  }

  #main-content .section-heading > p:not(.eyebrow) {
    width: 100%;
    max-width: none;
  }

  /* Match homepage section headings to the Shop page heading. */
  #main-content .section-heading h2 {
    font-family: var(--font-display);
    font-size: clamp(2.66rem, 5.6vw, 4.9rem);
    font-weight: 700;
  }

  /* Reduce the gap between the Etsy preview CTA and About Brett to 30%. */
  #main-content .etsy-preview-section {
    padding-bottom: clamp(1.5rem, 3vw, 2.7rem);
  }

  #main-content #about {
    padding-top: clamp(1.5rem, 3vw, 2.7rem);
  }
</style>
