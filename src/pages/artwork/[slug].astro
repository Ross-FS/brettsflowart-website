---
import MainLayout from '../../layouts/MainLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { artworks, type Artwork } from '../../data/artworks';

export function getStaticPaths() {
  return artworks.map((artwork, index) => ({ params: { slug: artwork.slug }, props: { artwork, index } }));
}

interface Props { artwork: Artwork; index: number; }
const { artwork, index } = Astro.props;
const previous = artworks[(index - 1 + artworks.length) % artworks.length];
const next = artworks[(index + 1) % artworks.length];
const enquirySubject = encodeURIComponent(`Enquiry about ${artwork.title} (${artwork.catalogNumber})`);
const artworkSchema = {
  '@type': 'VisualArtwork',
  name: artwork.title,
  identifier: artwork.catalogNumber,
  image: new URL(artwork.image, Astro.site ?? 'https://brettsflowart.au').toString(),
  artMedium: artwork.medium,
  creator: { '@type': 'Person', name: 'Brett Forbes-Stephen' },
};
---

<MainLayout
  title={`${artwork.title} | Brett's Flow Art`}
  description={`${artwork.title}, ${artwork.medium.toLowerCase()} by Brett Forbes-Stephen in Donnybrook, Western Australia.`}
  canonicalPath={`/artwork/${artwork.slug}/`}
  ogImage={artwork.image}
  structuredData={artworkSchema}
>
  <SiteHeader solid />
  <main id="main-content" class="subpage-main artwork-page">
    <div class="shell artwork-page__back"><a class="text-link" href="/gallery/">← Back to the gallery</a></div>

    <article class="shell artwork-detail">
      <div class="artwork-detail__image">
        <img src={artwork.image} alt={artwork.alt} width={artwork.width} height={artwork.height} decoding="async" />
      </div>
      <div class="artwork-detail__content">
        <p class="eyebrow">{artwork.categoryLabel}</p>
        <h1>{artwork.title}</h1>
        <p class="artwork-detail__catalog">Catalogue {artwork.catalogNumber}</p>
        <p class="artwork-detail__description">{artwork.description}</p>
        <dl class="artwork-facts">
          <div><dt>Medium</dt><dd>{artwork.medium}</dd></div>
          <div><dt>Dimensions</dt><dd>{artwork.dimensions}</dd></div>
          <div><dt>Availability</dt><dd>{artwork.availability}</dd></div>
          <div><dt>Price</dt><dd>{artwork.price}</dd></div>
        </dl>
        <a class="button button--catalog" href={`mailto:hello@brettsflowart.au?subject=${enquirySubject}`}>Enquire about this work</a>
      </div>
    </article>

    <nav class="shell artwork-pagination" aria-label="Artwork navigation">
      <a href={`/artwork/${previous.slug}/`}><span>Previous</span><strong>{previous.title}</strong></a>
      <a href={`/artwork/${next.slug}/`}><span>Next</span><strong>{next.title}</strong></a>
    </nav>
  </main>
  <SiteFooter />
</MainLayout>
