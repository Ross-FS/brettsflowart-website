<dialog class="lightbox catalog-lightbox" data-lightbox aria-label="Artwork viewer">
  <button class="lightbox__close" type="button" data-lightbox-close aria-label="Close artwork viewer">×</button>
  <button class="lightbox__nav lightbox__nav--previous" type="button" data-lightbox-previous aria-label="Previous artwork">‹</button>

  <figure>
    <div class="catalog-lightbox__image-wrap" data-lightbox-stage aria-live="polite">
      <p class="catalog-lightbox__message" data-lightbox-loading>Loading artwork…</p>
      <img data-lightbox-image alt="" hidden />
      <p class="catalog-lightbox__message" data-lightbox-error hidden>
        The full-size image could not be loaded.
      </p>
    </div>

    <figcaption>
      <span data-lightbox-caption></span>
      <small data-lightbox-meta></small>
      <a class="button button--glass" data-lightbox-detail href="/gallery/">Artwork details</a>
    </figcaption>
  </figure>

  <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label="Next artwork">›</button>
</dialog>

<script>
  const dialog = document.querySelector('.catalog-lightbox[data-lightbox]');

  if (dialog instanceof HTMLDialogElement) {
    const image = dialog.querySelector('[data-lightbox-image]');
    const caption = dialog.querySelector('[data-lightbox-caption]');
    const meta = dialog.querySelector('[data-lightbox-meta]');
    const detailLink = dialog.querySelector('[data-lightbox-detail]');
    const loadingMessage = dialog.querySelector('[data-lightbox-loading]');
    const errorMessage = dialog.querySelector('[data-lightbox-error]');
    const closeButton = dialog.querySelector('[data-lightbox-close]');
    const previousButton = dialog.querySelector('[data-lightbox-previous]');
    const nextButton = dialog.querySelector('[data-lightbox-next]');

    let activeItem;
    let loadSequence = 0;

    const setHidden = (element, hidden) => {
      if (element instanceof HTMLElement) element.hidden = hidden;
    };

    const visibleItems = () =>
      Array.from(document.querySelectorAll('[data-lightbox-item]')).filter((item) => {
        if (!(item instanceof HTMLElement)) return false;
        const card = item.closest('[data-gallery-card]');
        return !(card instanceof HTMLElement) || !card.hidden;
      });

    const loadImage = (item) => {
      if (!(item instanceof HTMLElement) || !(image instanceof HTMLImageElement)) return;

      const fullSource = item.dataset.lightboxSrc ?? '';
      const fallbackSource = item.dataset.lightboxFallback ?? '';
      const currentSequence = ++loadSequence;
      let fallbackAttempted = false;

      setHidden(image, true);
      setHidden(loadingMessage, false);
      setHidden(errorMessage, true);
      image.removeAttribute('src');
      image.alt = item.dataset.lightboxAlt ?? '';

      const revealImage = () => {
        if (currentSequence !== loadSequence) return;
        setHidden(loadingMessage, true);
        setHidden(errorMessage, true);
        setHidden(image, false);
      };

      const showError = () => {
        if (currentSequence !== loadSequence) return;
        setHidden(loadingMessage, true);
        setHidden(image, true);
        setHidden(errorMessage, false);
      };

      image.onload = revealImage;
      image.onerror = () => {
        if (!fallbackAttempted && fallbackSource && fallbackSource !== fullSource) {
          fallbackAttempted = true;
          image.src = fallbackSource;
          return;
        }
        showError();
      };

      if (!fullSource) {
        showError();
        return;
      }

      image.src = fullSource;

      // Cached images may already be complete before the load listener runs.
      if (image.complete && image.naturalWidth > 0) revealImage();
    };

    const showItem = (item) => {
      if (!(item instanceof HTMLElement)) return;
      activeItem = item;

      if (caption) caption.textContent = item.dataset.lightboxTitle ?? '';
      if (meta) meta.textContent = item.dataset.lightboxMeta ?? '';
      if (detailLink instanceof HTMLAnchorElement) {
        detailLink.href = item.dataset.lightboxDetail ?? '/gallery/';
      }

      loadImage(item);
    };

    const move = (offset) => {
      const items = visibleItems();
      if (!items.length) return;
      const currentIndex = Math.max(0, items.indexOf(activeItem));
      showItem(items[(currentIndex + offset + items.length) % items.length]);
    };

    // Event delegation keeps the lightbox working when filtering or revealing more cards.
    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const item = target.closest('[data-lightbox-item]');
      if (!(item instanceof HTMLElement)) return;

      showItem(item);
      if (!dialog.open) dialog.showModal();
    });

    closeButton?.addEventListener('click', () => dialog.close());
    previousButton?.addEventListener('click', () => move(-1));
    nextButton?.addEventListener('click', () => move(1));

    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    document.addEventListener('keydown', (event) => {
      if (!dialog.open) return;
      if (event.key === 'ArrowLeft') move(-1);
      if (event.key === 'ArrowRight') move(1);
    });
  }
</script>
