---
import GalleryCard from './GalleryCard.astro';
import GalleryLightbox from './GalleryLightbox.astro';
import { featuredArtworks } from '../data/artworks';
---

<section class="gallery-section section" id="gallery" aria-labelledby="gallery-title">
  <div class="shell">
    <div class="section-heading section-heading--split">
      <div>
        <p class="eyebrow">Selected artwork</p>
        <h2 id="gallery-title">One process. Endless possibilities.</h2>
      </div>
      <div class="section-heading__action">
        <p>Brett's pours celebrate the tension between intention and chance. Explore the complete online catalogue.</p>
        <a class="text-link" href="/gallery/">View all artwork →</a>
      </div>
    </div>

    <div class="catalog-grid catalog-grid--featured" data-gallery-grid>
      {featuredArtworks.map((artwork, index) => <GalleryCard artwork={artwork} index={index} compact />)}
    </div>

    <div class="gallery-section__button">
      <a class="button button--catalog" href="/gallery/">Explore the full gallery</a>
    </div>
  </div>
  <GalleryLightbox />
</section>
