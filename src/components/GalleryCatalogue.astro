---
import GalleryCard from './GalleryCard.astro';
import GalleryLightbox from './GalleryLightbox.astro';
import { artworks } from '../data/artworks';
---

<section class="catalog-section" aria-labelledby="catalog-title">
  <div class="catalog-toolbar" data-gallery-toolbar>
    <div class="catalog-filters" role="group" aria-label="Filter artwork">
      <button class="filter-button is-active" type="button" data-gallery-filter="all">All works</button>
      <button class="filter-button" type="button" data-gallery-filter="painting">Original artwork</button>
      <button class="filter-button" type="button" data-gallery-filter="functional-art">Functional art</button>
    </div>
    <label class="catalog-search">
      <span class="visually-hidden">Search the gallery</span>
      <input type="search" placeholder="Search title or catalogue number" data-gallery-search />
    </label>
  </div>

  <div class="catalog-status" aria-live="polite">
    <p data-gallery-count>Showing artwork</p>
  </div>

  <div class="catalog-grid" data-gallery-grid>
    {artworks.map((artwork, index) => <GalleryCard artwork={artwork} index={index} />)}
  </div>

  <div class="catalog-load-more">
    <button class="button button--catalog" type="button" data-gallery-load-more>Show more artwork</button>
  </div>

  <GalleryLightbox />
</section>

<script>
  const cards = Array.from(document.querySelectorAll('[data-gallery-card]'));
  const filters = Array.from(document.querySelectorAll('[data-gallery-filter]'));
  const search = document.querySelector('[data-gallery-search]');
  const count = document.querySelector('[data-gallery-count]');
  const loadMore = document.querySelector('[data-gallery-load-more]');
  let activeFilter = 'all';
  let limit = 24;
  const pageSize = 24;

  const applyGallery = () => {
    const term = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
    const matches = cards.filter((card) => {
      if (!(card instanceof HTMLElement)) return false;
      const categoryMatch = activeFilter === 'all' || card.dataset.category === activeFilter;
      const searchMatch = !term || (card.dataset.search ?? '').includes(term);
      return categoryMatch && searchMatch;
    });

    cards.forEach((card) => card instanceof HTMLElement && (card.hidden = true));
    matches.slice(0, limit).forEach((card) => card instanceof HTMLElement && (card.hidden = false));

    if (count) count.textContent = `Showing ${Math.min(limit, matches.length)} of ${matches.length} works`;
    if (loadMore instanceof HTMLButtonElement) loadMore.hidden = limit >= matches.length;
  };

  filters.forEach((button) => {
    button.addEventListener('click', () => {
      activeFilter = button instanceof HTMLElement ? button.dataset.galleryFilter ?? 'all' : 'all';
      limit = pageSize;
      filters.forEach((item) => item.classList.toggle('is-active', item === button));
      applyGallery();
    });
  });

  search?.addEventListener('input', () => {
    limit = pageSize;
    applyGallery();
  });

  loadMore?.addEventListener('click', () => {
    limit += pageSize;
    applyGallery();
  });

  applyGallery();
</script>
